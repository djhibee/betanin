#!/bin/sh

echo "!! warning, the docker volumes for this container have changed!"
echo "!! mounts in the container prefixed with /root should now be /b"
echo "!!"
echo "!! for example, with docker-compose you can set"
echo "!! volumes:"
echo "!!  - ./data:/b/.local/share/betanin/ # betanin database"
echo "!!  - ./config:/b/.config/betanin/    # betanin config"
echo "!!  - ./beets:/b/.config/beets/       # beets config"
echo "!!"
echo "!! it is also recommended that you set the UID/GID environment variables"
echo "!!"
echo "!! for more info, check the README"
echo "!! https://github.com/sentriz/betanin"
echo "!!"
echo "!! thanks!"

if [ "$UID" -eq 0 ]; then
    echo "!! WARNING: running as root (UID=0). betanin and beets will have full"
    echo "!! control of the container and every mounted volume. set UID/GID to an"
    echo "!! unprivileged user (e.g. UID=1000 GID=1000) unless you really need root."
    exec betanin
fi

# reuse the group if the GID already exists in the image, else create it
group="$(getent group "$GID" | cut -d: -f1)"
if [ -z "$group" ]; then
    group=betanin
    addgroup -g "$GID" "$group"
fi
# reuse the user if the UID already exists (e.g. on container restart)
user="$(getent passwd "$UID" | cut -d: -f1)"
if [ -z "$user" ]; then
    user=betanin
    # busybox: -G sets the primary group (-g is the GECOS field)
    adduser -D -h "$HOME" -u "$UID" -G "$group" "$user"
fi
chown -R "$UID:$GID" "$HOME"
exec su-exec "$UID:$GID" betanin
